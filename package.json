{
  "name": "motif-engine",
  "version": "0.1.0",
  "description": "Strudel Song Engine: iterative, verified AI music generation",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "README.md"
  ],
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./harness": "./src/harness/index.js",
    "./evaluate": "./src/harness/evaluate.js",
    "./binder": "./src/binder/adapter.js",
    "./compiler": "./src/compiler/compile.js",
    "./vibes": "./src/lib/vibes.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "motif-engine": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "listen": "node scripts/serve.mjs",
    "verify": "node src/cli.js verify",
    "generate": "node src/cli.js generate",
    "edit": "node src/cli.js edit"
  },
  "dependencies": {
    "@strudel/core": "1.1.0",
    "@strudel/mini": "1.1.0",
    "@strudel/reference": "1.1.0",
    "@strudel/tonal": "1.1.0",
    "@strudel/transpiler": "1.1.0",
    "@tonejs/midi": "^2.0.28",
    "acorn": "^8.11.0",
    "acorn-walk": "^8.3.0"
  }
}
