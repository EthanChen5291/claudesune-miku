// "Attic Light" — lo-fi hip-hop in C minor, 84 BPM
// form: A B A B, 8 bars per section (1 cycle = 1 bar, 4 beats per cycle)
// A (verse):  Cm9 · Fm9 · Abmaj7 · G7b9
// B (chorus): Fm9 · Bb9 · Ebmaj9 · G7b9

setcpm(84/4)

// ---------- harmony (one chord per 2 bars) ----------
let chordsA = note("<[c3,eb3,g3,bb3,d4] [f2,ab2,c3,eb3,g3] [ab2,c3,eb3,g3] [g2,b2,f3,ab3]>")
  .slow(2)
let chordsB = note("<[f2,ab2,c3,eb3,g3] [bb2,d3,ab3,c4] [eb3,g3,bb3,d4] [g2,b2,f3,ab3]>")
  .slow(2)

// ---------- bass ----------
let bassA = note("<[c2 ~ [~ c2] ~] [f1 ~ [~ c2] ~] [ab1 ~ [~ eb2] ~] [g1 ~ [f2 d2] ~]>")
let bassB = note("<[f1 ~ [~ f2] ~] [bb1 ~ [~ f2] ~] [eb2 ~ [~ bb1] ~] [g1 ~ [~ b1] ~]>")

// ---------- sleepy melody (4-bar phrases) ----------
let leadA = note("<[~ ~ eb5 [~ d5]] [c5 ~ ~ ~] [~ ~ g4 [~ bb4]] [~ b4 d5@2]>")
let leadB = note("<[~ eb5 ~ f5] [g5 ~ [f5 eb5] ~] [~ c5 ~ eb5] [d5@2 [c5 b4] ~]>")

// ---------- drums (2-bar patterns, velocity contours via gain patterns) ----------
// gain patterns mirror the hit grid: full values on accents, low values = ghosts,
// mid values fall on rests (don't-cares) so no event is ever dropped or moved
let kickA = s("<[bd ~ ~ ~ ~ ~ ~ bd ~ ~ bd ~ ~ ~ ~ ~] [bd ~ ~ ~ ~ ~ ~ bd ~ ~ bd ~ ~ ~ bd ~]>")
  .gain("<[1 .6 .6 .55 .6 .85 .6 .6] [1 .6 .6 .55 .6 .85 .6 .7]>")
let kickB = s("<[bd ~ ~ ~ ~ ~ ~ bd ~ ~ ~ ~ bd ~ ~ ~] [bd ~ ~ bd ~ ~ ~ bd ~ ~ bd ~ ~ ~ ~ ~]>")
  .gain("<[1 .6 .6 .55 .6 .6 .9 .6] [1 .5 .6 .55 .6 .85 .6 .6]>")

let snareA = s("<[~ sd ~ sd] [~ sd ~ [sd ~ ~ sd]]>")
  .gain("<[.7 .9 .7 .95] [.7 .9 .7 [.95 .7 .7 .35]]>")
let snareB = s("<[~ sd ~ sd] [~ sd [~ ~ ~ sd] sd]>")
  .gain("<[.7 .9 .7 .95] [.7 .9 [.7 .7 .7 .3] .95]>")

let hatsA = s("hh*8")
  .gain("[.5 .8 .45 .75 .5 .8 .45 .85]")
let hatsB = s("hh hh [hh hh] hh hh hh [hh hh] hh")
  .gain("[.5 .8 [.45 .35] .75 .5 .8 [.45 .3] .85]")

let ohatA = s("<[~ ~ ~ [~ oh]] [~ ~ ~ ~]>").gain(.5)
let ohatB = s("<[~ [~ oh] ~ ~] [~ ~ ~ [~ oh]]>").gain("<.6 .45>")

let rimB = s("~ [~ rim] ~ [~ ~ rim ~]")
  .gain("[.6 [.6 .7] .6 [.6 .6 .4 .6]]")

// ================= voices =================

kick: arrange([8, kickA], [8, kickB], [8, kickA], [8, kickB])
  .shape(.2)

snare: arrange([8, snareA], [8, snareB], [8, snareA], [8, snareB])
  .room(.15)

hats: arrange([8, hatsA], [8, hatsB], [8, hatsA], [8, hatsB])
  .swingBy(1/3, 4)
  .hpf(4000)

openhat: arrange([8, ohatA], [8, ohatB], [8, ohatA], [8, ohatB])
  .swingBy(1/3, 4)
  .hpf(3000)

rim: arrange([8, silence], [8, rimB], [8, silence], [8, rimB])
  .room(.25)

bass: arrange([8, bassA], [8, bassB], [8, bassA], [8, bassB])
  .s("gm_acoustic_bass")
  .lpf(900)
  .release(.1)
  .gain(.85)

chords: arrange([8, chordsA], [8, chordsB], [8, chordsA], [8, chordsB])
  .struct("x ~ [~ x] ~")
  .s("gm_epiano1")
  .lpf(1800)
  .room(.4)
  .gain(.6)

lead: arrange([8, leadA], [8, leadB], [8, leadA], [8, leadB])
  .s("gm_vibraphone")
  .lpf(2200)
  .room(.5)
  .delay(.3)
  .gain(.5)

vinyl: s("crackle*4").density(.04).gain(1.2)
