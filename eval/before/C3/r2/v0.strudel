// "Sleepwalk Season" — lo-fi hip-hop in C minor, 84 BPM
// form: A (verse, 8 bars) / B (chorus, 8 bars) / A / B — 32-bar loop
// 1 cycle = 1 bar of 4/4, so 84 BPM = 21 cycles per minute

setcpm(84/4)

// ---------- harmony ----------
let verseChords  = chord("<Cm9 Ab^9 Fm7 G7b9>").dict('ireal').anchor("eb4")
let chorusChords = chord("<Fm9 Bb13 Eb^9 Ab^7>").dict('ireal').anchor("eb4")

let verseRoots  = note("<c2 ab1 f1 g1>")
let chorusRoots = note("<f1 bb1 eb2 ab1>")

let chordRhythm = "x ~ [~ x] ~"
let bassRhythm  = "[x ~ ~ ~] [~ ~ ~ x] [~ ~ x ~] [~ ~ x ~]"

// ---------- melody (sleepy, behind the beat) ----------
let verseLead  = note("<[~ ~ g4 [~ eb4]] [d4@2 ~ c4] [~ [~ ab3] c4 [eb4 ~]] [d4 ~ [~ b3] ~]>")
let chorusLead = note("<[~ c4 [~ eb4] f4] [g4@2 ~ [f4 d4]] [eb4 ~ [~ bb3] ~] [~ c4@2 ~]>")

// ---------- drums ----------
kick: s("<[bd ~ ~ ~ ~ ~ ~ bd ~ ~ bd ~ ~ ~ ~ ~] [bd ~ ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~ bd ~ ~]>")
  .bank("RolandTR808")
  .shape(.3).lpf(3500).gain(.9)

snare: s("<[~ sd ~ sd] [~ sd ~ [sd ~ ~ sd]]>")
  .bank("RolandTR808")
  .lpf(6500).gain(.8)

hats: s("hh*8")
  .gain(.55)
  .swingBy(1/3, 4)
  .bank("RolandTR808")
  .lpf(9000)

ohat: arrange(
  [8, silence],
  [8, s("~ ~ ~ [~ oh]").swingBy(1/3, 4)],
  [8, silence],
  [8, s("~ ~ ~ [~ oh]").swingBy(1/3, 4)]
).bank("RolandTR808").lpf(8000).gain(.45)

rim: arrange(
  [8, s("~ ~ ~ [~ rim]")],
  [8, silence],
  [8, s("~ ~ ~ [~ rim]")],
  [8, silence]
).bank("RolandTR808").gain(.4)

// ---------- music ----------
bass: arrange(
  [8, verseRoots.struct(bassRhythm)],
  [8, chorusRoots.struct(bassRhythm)],
  [8, verseRoots.struct(bassRhythm)],
  [8, chorusRoots.struct(bassRhythm)]
).s("gm_acoustic_bass").clip(3).release(.2).lpf(750).gain(.8)

chords: arrange(
  [8, verseChords.voicing().struct(chordRhythm)],
  [8, chorusChords.voicing().struct(chordRhythm)],
  [8, verseChords.voicing().struct(chordRhythm)],
  [8, chorusChords.voicing().struct(chordRhythm)]
).s("gm_epiano1").clip(2).attack(.02).release(.4).lpf(1500).room(.35).gain(.55)

pad: arrange(
  [8, silence],
  [8, chorusChords.anchor("g4").voicing().struct("x")],
  [8, silence],
  [8, chorusChords.anchor("g4").voicing().struct("x")]
).s("sawtooth").attack(.5).release(1.2).lpf(800).room(.6).gain(.13)

lead: arrange(
  [8, verseLead],
  [8, chorusLead],
  [8, verseLead],
  [8, chorusLead]
).s("gm_vibraphone").late(.01).clip(1.2).release(.4).lpf(2000).room(.5).gain(.6)

vinyl: s("crackle*4").density(.2).gain(.4)
