// "Vapor Lines" — F minor house @ 122 BPM
// form: A (16 bars) | B chorus (16) | A' varied return, busier drums (16) | B chorus (16) = 64-bar loop
setcpm(122/4)

// ---- section masks: 1 cycle = 1 bar, 64-bar form ----
let mA  = "<1!16 0!16 0!16 0!16>" // verse A
let mB  = "<0!16 1!16 0!16 1!16>" // chorus B (both passes)
let mA2 = "<0!16 0!16 1!16 0!16>" // A' — verse return, busier drums
let mAA = "<1!16 0!16 1!16 0!16>" // A + A' (shared verse material)

// ---- harmony: Fm7 | Abmaj7 | Dbmaj7 | Eb7, 4-bar loop ----
let prog   = "<[f3,ab3,c4,eb4] [ab3,c4,eb4,g4] [db3,f3,ab3,c4] [eb3,g3,bb3,db4]>"
let progHi = "<[f3,ab3,c4,eb4,g4] [ab3,c4,eb4,g4,bb4] [db3,f3,ab3,c4,eb4] [eb3,g3,bb3,db4,f4]>"

// ---- melodies: verse shared by A and A'; chorus now a full octave up, no rests ----
let verseMel  = "<[f4 ~ ab4 ~ c5 ~ ab4 g4] [f4 ~ ~ g4 ~ ~ eb4 ~] [db4 ~ f4 ~ ab4 ~ g4 f4] [c4 ~ eb4 ~ g4 ~ f4 ~]>"
let chorusMel = "<[f5 g5 ab5 c6 f5 eb5 ab5 g5] [eb5 g5 c6 g5 ab5 eb5 bb5 c6] [ab5 f5 db5 f5 ab5 c6 bb5 ab5] [eb5 f5 g5 bb5 c6 bb5 g5 f5]>"

kick: s("bd*4").bank("RolandTR909").gain(1)

hats: stack(
  s("hh*8").gain("[.3 .5]*4").mask(mAA),                       // verse: full 8ths, offbeat accented
  s("hh*16").gain("[.18 .26 .2 .3]*4").mask(mA2),              // A': 16th carpet on top
  s("[~ oh]*4").gain(.4).mask(mB),                             // chorus open offbeats
  s("[hh hh hh hh*2]*4").gain("[.24 .32 .27 .4]*4").mask(mB)   // chorus 16ths with ratchets
).bank("RolandTR909")

clap: s("[~ cp]*2").bank("RolandTR909").gain(.8).room(.2)

snare: stack(
  s("[~ ~ ~ sd]*2").gain(.28).mask(mA2),              // ghost hits in A'
  s("~ sd ~ sd").gain(.5).mask(mB),                   // backbeat layer in chorus
  s("sd*8").gain("[.2 .24 .28 .32 .36 .42 .5 .6]")
    .mask("<0!15 1 0!16 0!15 1 0!16>")                // build fill in the bar before each chorus
).bank("RolandTR909")

perc: stack(
  s("~ ~ ~ rim ~ ~ ~ rim").gain(.45).mask(mA2),       // rim syncopation in A'
  s("rd*4").gain(.22).mask(mB)                        // ride wash in chorus
).bank("RolandTR909")

bass: note("<[~ f1 ~ f1 ~ f1 ~ f2] [~ ab1 ~ ab1 ~ ab1 ~ ab2] [~ db1 ~ db1 ~ db1 ~ db2] [~ eb1 ~ eb1 ~ eb1 eb2 eb1]>")
  .s("sawtooth").lpf(800).lpq(6).clip(.85).gain(.85)

chords: stack(
  note(prog).struct("[~ x]*4").s("sawtooth")
    .lpf(1200).attack(.01).release(.08).clip(.5).gain(.5).room(.25).mask(mAA),
  note(progHi).add(note("0,12")).struct("[~ x ~ x] [~ x x ~] [~ x ~ x] [~ x x x]").s("sawtooth")
    .lpf(1900).attack(.005).release(.1).clip(.55).gain(.5).room(.3).mask(mB)
)

pads: note("<[f4,ab4,c5,f5] [ab4,c5,eb5,g5] [ab4,db5,f5,ab5] [g4,bb4,eb5,g5]>")
  .s("sawtooth").attack(.35).sustain(.7).release(.7)
  .lpf(1500).gain(.34).room(.6).mask(mB)

arp: note("<[f4 c5 f5 ab5]*4 [ab4 eb5 ab5 c6]*4 [db4 ab4 f5 ab5]*4 [eb4 bb4 g5 bb5]*4>")
  .s("square").lpf(2600).clip(.5).gain(.28).delay(.2).pan("[.35 .65]*8").mask(mB)

lead: stack(
  note(verseMel).s("triangle").lpf(2000).gain(.55).clip(.8).delay(.18).room(.3).mask(mAA),
  note(chorusMel).s("sawtooth").lpf(3000).gain(.5)
    .off(1/8, x => x.add(note(12)).gain(.3).lpf(3600))          // sparkling octave echo on top
    .clip(.75).delay(.22).room(.35).mask(mB)
)
