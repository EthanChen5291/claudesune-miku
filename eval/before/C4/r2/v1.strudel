// "Meridian Lights" — melodic trance in A minor @ 138 BPM
// Form: A (cycles 0-15) | B chorus (16-31) | C breakdown (32-47) | B final chorus (48-63)
// One cycle = one bar (4/4). The whole form is 64 cycles, then it loops.

setcpm(138/4)

// ---- harmonic material (scale degrees of A minor) ----
// progression: Am | F | C | G  (one chord per bar)
let prog  = "<[0,2,4] [-2,0,2] [2,4,6] [-1,1,3]>"
let arpsq = "<[0 2 4 7]*4 [-2 0 2 5]*4 [2 4 6 9]*4 [-1 1 3 6]*4>"
let roots = "<0 -2 2 -1>"
let hook  = `<
  [4 ~ 3 4] [2 ~ ~ [3 2]] [4 ~ 6 ~] [8 ~ 7 ~]
  [4 ~ 3 4] [5 ~ 4 ~]     [9 ~ 8 7] [6 ~ [7 8] ~]
>`

// ---- section masks over the 64-bar form ----
let mA  = "<1!16 0!48>"            // A only
let mB  = "<0!16 1!16 0!16 1!16>"  // both choruses
let mC  = "<0!32 1!16 0!16>"       // breakdown only
let mAB = "<1!32 0!16 1!16>"       // everything except the breakdown

// ---- drums ----
kick: s("bd*4").bank("RolandTR909").gain(1.1).mask(mAB)

hats: s("[~ hh]*4").bank("RolandTR909").gain(0.5).mask(mAB)

shimmer: s("hh*16").bank("RolandTR909").hpf(8000)
  .gain("[0.35 0.15 0.25 0.15]*4")
  .mask(mB)

clap: s("~ cp ~ cp").bank("RolandTR909").gain(0.65).room(0.25).mask(mB)

snare: s("~ sd ~ sd").bank("RolandTR909").gain(0.35).mask(mB)

// ---- bass: rolling offbeat 16ths on the chord roots ----
bass: n(roots).scale("A1:minor").struct("[~ x x x]*4")
  .s("sawtooth").attack(0.002).decay(0.14).sustain(0)
  .lpf("<700!16 1100!16 700!16 1300!16>").lpq(6)
  .gain(0.85)
  .mask(mAB)

// ---- harmony ----
chords: n(prog).scale("A3:minor").s("sawtooth")
  .attack(0.35).release(0.8)
  .lpf(sine.slow(8).range(600, 2200))
  .room(0.5)
  .gain("<0.26!16 0.36!16 0.48!16 0.4!16>")

pluck: n(arpsq).scale("A3:minor").s("sawtooth")
  .attack(0.001).decay(0.13).sustain(0)
  .lpf("<900!16 2600!16 500!8 1600!8 3000!16>")
  .delay(0.3).delaytime(0.326).delayfeedback(0.35)
  .gain(0.55)
  .mask("<1!32 0!8 1!24>")

// ---- lead: supersaw hook, enters at the first chorus ----
lead: n(hook).scale("A4:minor").s("supersaw")
  .unison(5).detune(0.2).spread(0.7)
  .attack(0.02).release(0.25)
  .lpf("<1200!16 3000!16 2000!16 3400!16>")
  .room("<0.3!32 0.7!16 0.35!16>")
  .gain("<0!16 0.4!16 0.28!16 0.48!16>")
  .mask("<0!16 1!48>")

// ---- transition material (own layers) ----
// crash impact on the downbeat of each chorus (cycles 16 and 48)
crash: s("cr").bank("RolandTR909").gain(0.6).room(0.4)
  .mask("<0!16 1 0!31 1 0!15>")

// 2-bar white-noise riser into the FIRST chorus (cycles 14-15)
riser: s("white*16").hpf(200)
  .lpf(saw.slow(2).range(400, 9000))
  .gain(saw.slow(2).range(0.05, 0.4))
  .mask("<0!14 1!2 0!48>")

// 4-bar white-noise riser into the FINAL chorus (cycles 44-47) — longer and louder
riserlong: s("white*16").hpf(150)
  .lpf(saw.slow(4).range(300, 11000))
  .gain(saw.slow(4).range(0.03, 0.55))
  .mask("<0!44 1!4 0!16>")

// 4-bar tonal uplifter into the FINAL chorus: sawtooth glissando A2 -> A4
risertone: note(saw.slow(4).range(45, 69).segment(16)).s("sawtooth")
  .lpf(saw.slow(4).range(800, 6000))
  .gain(saw.slow(4).range(0.05, 0.3))
  .room(0.4)
  .mask("<0!44 1!4 0!16>")

// 1-bar snare-roll fill before the FIRST chorus (cycle 15)
fill: s("sd*16").bank("RolandTR909")
  .gain(saw.range(0.2, 0.65))
  .speed(saw.range(1, 1.4))
  .room(0.2)
  .mask("<0!15 1 0!48>")

// 2-bar accelerating snare roll before the FINAL chorus (cycles 46-47)
fillbig: s("<[sd*8] [sd*16]>").bank("RolandTR909")
  .gain(saw.slow(2).range(0.2, 0.85))
  .speed(saw.slow(2).range(1, 1.7))
  .room(0.25)
  .mask("<0!46 1!2 0!16>")

// tom run stacked on the last fill bar (cycle 47)
filltoms: s("lt lt mt mt ht ht ht ht").bank("RolandTR909")
  .gain(saw.range(0.4, 0.7))
  .mask("<0!47 1 0!16>")
