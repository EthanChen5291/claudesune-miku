// "Northlight" — melodic trance, A minor, 138 BPM
// Form: A (intro) | B (chorus) | C (breakdown) | B (final chorus) — 16 bars each, 64 bars total
// 1 cycle = 1 bar (4 beats). setcpm(138/4) => 138 BPM.

setcpm(138/4)

// ---------- shared material ----------
// progression: Am | F | C | G  (i - VI - III - VII), as scale-degree offsets
let prog = "<0 -2 2 -1>"

// lead melody: scale degrees of A minor (0 = root), 4-bar phrase, 8ths
let leadMel = `<
  [0 ~ 4 ~ 2 ~ 4 5]
  [-2 ~ 2 ~ 0 ~ 2 3]
  [2 ~ 6 ~ 4 ~ 6 7]
  [6 ~ 4 ~ 3 1 3 4]
>`

// ---------- section masks (64 bars, 1 = section active on that bar) ----------
let inA      = "<1!16 0!48>"              // bars 1-16
let inB      = "<0!16 1!16 0!16 1!16>"    // bars 17-32 + 49-64 (both choruses)
let inC      = "<0!32 1!16 0!16>"         // bars 33-48 (breakdown)
let inB2     = "<0!48 1!16>"              // bars 49-64 (final chorus only)
let kickOn   = "<1!32 0!16 1!16>"         // A + chorus 1, out for breakdown, back for final chorus
let hatsOn   = "<0!8 1!24 0!16 1!16>"     // hats join at bar 9
let bassOn   = "<0!4 1!28 0!16 1!16>"     // bass joins at bar 5
let padOn    = "<0!32 1!32>"              // breakdown + final chorus
let leadOn   = "<0!16 1!48>"              // both choruses + breakdown

// ---------- transition masks ----------
let riserOn  = "<0!12 1!4 0!48>"          // 4-bar riser into chorus 1 (bars 13-16)
let fillOn   = "<0!15 1 0!48>"            // 1-bar drum fill into chorus 1 (bar 16)
let riser2On = "<0!40 1!8 0!16>"          // 8-bar riser into final chorus (bars 41-48)
let fill2On  = "<0!46 1!2 0!16>"          // 2-bar drum fill into final chorus (bars 47-48)
let impactOn = "<0!16 1 0!31 1 0!15>"     // crash impact on each chorus downbeat (bars 17, 49)

// ---------- drums ----------
kick: s("bd*4").bank("RolandTR909")
  .shape(0.3).gain(1.05)
  .mask(kickOn)

hats: s("hh*16").bank("RolandTR909")
  .gain("[0.22 0.32 0.26 0.42]*4")
  .hpf(6000).pan(0.55)
  .mask(hatsOn)

ohat: s("[~ oh]*4").bank("RolandTR909")
  .gain(0.4).hpf(5000).release(0.08)
  .mask(inB)

clap: s("~ cp ~ cp").bank("RolandTR909")
  .gain(0.75).room(0.25)
  .mask(inB)

// ---------- bass / harmony / melody ----------
bass: n("[~ 0 0 0]*4".add(prog)).scale("A1:minor")
  .s("sawtooth")
  .attack(0.002).decay(0.16).sustain(0).release(0.02)
  .lpf(700).gain(0.9)
  .mask(bassOn)

arp: n("[0 2 4 7 4 2 0 2]*2".add(prog)).scale("A3:minor")
  .s("sawtooth")
  .attack(0.001).decay(0.14).sustain(0.05).release(0.03)
  .lpf("<600!4 1000!4 1600!4 2600!4 3400!16 1600!16 3800!16>")
  .delay(0.25).delaytime(0.33).delayfeedback(0.35)
  .pan(0.4)
  .gain("<0.5!16 0.62!16 0.42!16 0.68!16>")

chords: n("[~ [0,2,4]]*4".add(prog)).scale("A4:minor")
  .s("supersaw").detune(0.25)
  .attack(0.002).decay(0.18).sustain(0).release(0.05)
  .lpf(2400).gain(0.42).pan(0.6)
  .mask(inB)

pad: n("[0,2,4,7]".add(prog)).scale("A3:minor")
  .s("supersaw").detune(0.4)
  .attack(0.6).decay(0.3).sustain(0.8).release(1)
  .lpf(1300).room(0.7).size(0.9)
  .gain("<0.45!48 0.3!16>")
  .mask(padOn)

lead: n(leadMel).scale("A4:minor")
  .s("supersaw").detune(0.3)
  .attack(0.01).decay(0.25).sustain(0.55).release(0.12)
  .lpf(3000)
  .room("<0.35!32 0.6!16 0.4!16>")
  .delay(0.3).delaytime(0.33).delayfeedback(0.35)
  .gain("<0.7!32 0.5!16 0.75!16>")
  .mask(leadOn)

lead2: n(leadMel).scale("A5:minor")
  .s("sawtooth")
  .attack(0.01).decay(0.2).sustain(0.4).release(0.1)
  .hpf(900).lpf(6000)
  .delay(0.35).delaytime(0.33).delayfeedback(0.4)
  .gain(0.3).pan(0.35)
  .mask(inB2)

// ---------- transition material ----------
riser: s("white*4")
  .attack(0.01).decay(0.2).sustain(0.7).release(0.1)
  .lpf(saw.slow(4).range(500, 11000))
  .hpf(250)
  .gain(saw.slow(4).range(0.05, 0.42))
  .room(0.4)
  .mask(riserOn)

fill: s("sd*4 sd*4 sd*8 sd*16").bank("RolandTR909")
  .gain(saw.range(0.35, 0.95))
  .speed(saw.range(0.95, 1.35))
  .hpf(200).room(0.3)
  .mask(fillOn)

// long 8-bar riser into the final chorus: wider sweep, louder, opens the hpf too
riser2: s("white*4")
  .attack(0.01).decay(0.2).sustain(0.8).release(0.1)
  .lpf(saw.slow(8).range(300, 15000))
  .hpf(saw.slow(8).range(150, 900))
  .gain(saw.slow(8).range(0.03, 0.55))
  .room(0.5)
  .mask(riser2On)

// 2-bar accelerating snare roll into the final chorus, pitch and level ramp up
fill2: s("<[sd*2 sd*4 sd*4 sd*8] [sd*8 sd*8 sd*16 sd*16]>").bank("RolandTR909")
  .gain(saw.slow(2).range(0.3, 1))
  .speed(saw.slow(2).range(0.9, 1.5))
  .hpf(200).room(0.35)
  .mask(fill2On)

impact: s("cr").bank("RolandTR909")
  .gain(0.85).room(0.5).size(0.9)
  .mask(impactOn)
