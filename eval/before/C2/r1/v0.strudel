// "Sevenwater" — instrumental groove in 7/8, D dorian
// form: A B C A, 8 bars per section; one cycle = one 7/8 bar
// quarter note = 140 bpm -> 140 / 3.5 = 40 cycles per minute
// C is a bridge with NO BASS; the bass returning in the final A is the payoff
setcpm(140/3.5)

// ---------------- drum patterns ----------------
let kickA = s(`<[bd ~ bd ~ bd ~ ~] [bd ~ bd ~ bd ~ [~ bd]]>`).bank("RolandTR909").gain(0.95)
let kickB = s(`<[bd ~ ~ bd ~ bd ~] [bd ~ ~ bd ~ bd [~ bd]]>`).bank("RolandTR909").gain(0.95)
let kickC = s("bd ~ ~ ~ ~ ~ ~").bank("RolandTR909").gain(0.8)

let snareA = s("~ ~ ~ sd ~ ~ sd").bank("RolandTR909").gain("0.9 0.65")
let snareB = s("~ [~ sd] ~ sd ~ ~ sd").bank("RolandTR909").gain("0.4 0.9 0.65")

let percB = s("~ rim ~ ~ rim ~ ~").bank("RolandTR808").gain(0.5)
let percC = s("~ rim ~ rim ~ ~ rim").bank("RolandTR808").gain(0.55).room(0.4)

let ohA = s("~!6 <~ oh>").bank("RolandTR909").gain(0.4)
let ohB = s("~ ~ ~ ~ ~ oh ~").bank("RolandTR909").gain(0.35)
let ohC = s("~!6 <~ ~ ~ oh>").bank("RolandTR909").gain(0.3)

let clapA2 = s("~ ~ ~ cp ~ ~ ~").bank("RolandTR909").gain(0.5).room(0.2)

// ---------------- tonal patterns (D dorian) ----------------
let bassA = note(`<
  [d2 ~ d2 ~ f2 ~ ~]
  [d2 ~ d2 ~ g2 ~ [~ a2]]
  [d2 ~ d2 ~ f2 ~ c3]
  [d2 ~ e2 ~ [g2 f2] ~ [e2 c2]]
>`)
let bassB = note(`<
  [f2 ~ f2 ~ a2 ~ ~]
  [g2 ~ g2 ~ b2 ~ [~ g2]]
  [a2 ~ a2 ~ c3 ~ g2]
  [g2 ~ f2 ~ [e2 f2] ~ [g2 a2]]
>`)

let chordsA = note("<[d3,f3,a3,c4] [g3,b3,d4,e4]>")
  .struct("~ x ~ x ~ ~ x")
  .s("gm_epiano1").gain(0.55).room(0.25).clip(2)
let chordsB = note("<[f3,a3,c4,e4] [g3,b3,d4,e4] [a3,c4,e4,g4] [g3,b3,d4,f4]>")
  .struct("x ~ ~ x ~ x ~")
  .s("gm_epiano1").gain(0.55).room(0.25).clip(2)
let chordsC = note(`<[d3,f3,c4,e4]!2 [f3,a3,c4,e4]!2 [e3,g3,b3,d4]!2 [g3,b3,d4,e4]!2>`)
  .s("sawtooth").lpf(1100).attack(0.5).release(2).gain(0.3).room(0.6)

let leadA = note(`<
  [~ ~ a4 ~ c5 ~ d5]
  [e5 ~ d5 ~ c5 ~ a4]
  [~ ~ a4 ~ b4 ~ d5]
  [c5 ~ b4 ~ a4 ~ g4]
>`)
let leadB = note(`<
  [f5 e5 c5 ~ d5 ~ a4]
  [b4 ~ d5 e5 ~ g5 ~]
  [f5 e5 c5 ~ d5 ~ e5]
  [g5 ~ f5 e5 [d5 e5] ~ b4]
>`)
let leadC = note(`<
  [~ ~ e5 ~ ~ ~ ~]
  [~ ~ ~ d5 ~ ~ ~]
  [~ ~ c5 ~ ~ b4 ~]
  [a4 ~ ~ ~ ~ ~ ~]
>`).attack(0.25).release(1.6).gain(0.65)

// ---------------- voices ----------------
kick: arrange([8, kickA], [8, kickB], [8, kickC], [8, kickA])

snare: arrange([8, snareA], [8, snareB], [8, silence], [8, snareA])

hats: s("hh*7").bank("RolandTR909")
  .gain("0.7 0.45 0.6 0.5 0.7 0.45 0.6")
  .off(1/14, x => x.gain(0.28).speed(1.4))

openhh: arrange([8, ohA], [8, ohB], [8, ohC], [8, ohA])

perc: arrange([8, silence], [8, percB], [8, percC], [8, percB])

clap: arrange([8, silence], [8, silence], [8, silence], [8, clapA2])

crash: s("<cr ~!7>").bank("RolandTR909").gain(0.4).room(0.3)

bass: arrange(
    [8, bassA.gain(0.85)],
    [8, bassB.gain(0.85)],
    [8, silence],
    [8, bassA.gain(1.05).superimpose(x => x.add(note(-12)).gain(0.5))]
  )
  .s("sawtooth").lpf(700).attack(0.005).decay(0.12).sustain(0.6).release(0.05).shape(0.2)

chords: arrange([8, chordsA], [8, chordsB], [8, chordsC], [8, chordsA])

lead: arrange([8, leadA], [8, leadB], [8, leadC], [8, leadA])
  .s("triangle").lpf(2600).delay(0.35).delaytime(0.43).delayfeedback(0.3).room(0.35)
