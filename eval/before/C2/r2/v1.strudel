// "Sevenfold" — instrumental groove in 7/8, D dorian
// form: A (8 bars) -> B (8) -> C bridge (8, NO BASS) -> A (8, bass returns = payoff), then loops
// tempo: one cycle = one 7/8 bar. eighth note = 7 * 40 = 280/min -> quarter note = 140 BPM
setcpm(40)

// ---------- A section: 2+2+3 groove on a Dm7 vamp ----------
let kickA = "<[bd ~ ~ ~ bd ~ ~] [bd ~ ~ ~ bd ~ bd]>"
let snareA = "<[~ ~ sd ~ ~ ~ ~] [~ ~ sd ~ ~ ~ [~ sd]]>"
let hatsA = "[hh hh hh hh hh hh <hh oh>]"
let percA = "<~ [~ ~ ~ ~ ~ ~ lt] ~ [~ ~ ~ ~ ~ mt lt]>"
let bassA = note("<[d1 ~ ~ d2 d1 ~ c1] [d1 ~ ~ d2 d1 ~ [f1 g1]] [d1 ~ ~ d2 d1 ~ a1] [d1 ~ ~ d2 d1 g1 [a1 c2]]>")
let chordsA = n("<[0,2,4,6] [1,3,5,8]>").struct("~ ~ x ~ ~ x ~")
let leadA = n("<[7 ~ 9 ~ 11 ~ [10 9]] [8 ~ ~ 7 ~ ~ ~] [7 ~ 9 ~ 11 ~ [12 11]] [13 ~ 11 ~ 10 ~ ~]>")

// ---------- B section: 3+2+2 groove, changes F^7 G7 Am7 C^7 ----------
let kickB = "<[bd ~ ~ bd ~ ~ ~] [bd ~ ~ bd ~ ~ bd]>"
let snareB = "[~ ~ ~ ~ ~ sd ~]"
let hatsB = "[hh hh hh hh hh <hh oh> hh]"
let percB = "<~ ~ ~ [~ ~ ~ ~ ~ mt ~] ~ ~ ~ [~ ~ ~ ~ ht mt lt]>"
let bassB = note("<[f1 ~ ~ f1 ~ c2 ~] [f1 ~ ~ e1 ~ f1 g1] [g1 ~ ~ g1 ~ d2 ~] [g1 ~ ~ f1 ~ g1 a1] [a1 ~ ~ a1 ~ e2 ~] [a1 ~ ~ g1 ~ a1 b1] [c2 ~ ~ c2 ~ g1 ~] [g1 ~ ~ a1 ~ b1 c2]>")
let chordsB = n("<[2,4,6,8]!2 [3,5,7,9]!2 [4,6,8,10]!2 [6,8,10,12] [3,5,7,9]>").struct("x ~ ~ x ~ x ~")
let leadB = n("<[9 ~ ~ 11 ~ 8 ~] [~ ~ 9 ~ 8 ~ 7] [10 ~ ~ 12 ~ 9 ~] [~ ~ 10 ~ 9 ~ 7] [11 ~ ~ 13 ~ 10 ~] [~ ~ 11 ~ 10 ~ 8] [13 ~ 12 ~ 10 ~ 9] [12 ~ ~ ~ 9 ~ ~]>")

// ---------- C section: bridge — bass fully withheld, thin drums, rising pad ----------
let kickC = "<[bd ~ ~ ~ ~ ~ ~]!5 ~ ~ [~ ~ ~ ~ ~ ~ bd]>"
let snareC = "[~ ~ rim ~ ~ rim ~]"
let hatsC = "[~ hh ~ hh ~ hh ~]"
let percC = "[rd ~ ~ ~ rd ~ ~]"
let padC = n("<[0,2,4,6]!2 [1,3,5,8]!2 [2,4,6,9]!2 [3,5,7,10]!2>")
let leadC = n("<[~ ~ 11 ~ ~ ~ ~] [~ ~ ~ ~ 9 ~ ~] [~ ~ 12 ~ ~ ~ ~] [~ ~ ~ ~ 10 ~ 8] [~ ~ 13 ~ ~ ~ ~] [~ ~ ~ 14 ~ ~ ~] [14 ~ 13 ~ 11 ~ ~] [10 ~ ~ 9 ~ 8 ~]>")

// ---------- voices ----------
kick: s(arrange([8, kickA], [8, kickB], [8, kickC], [8, kickA]))
  .bank("RolandTR909").gain(1)

snare: s(arrange([8, snareA], [8, snareB], [8, snareC], [8, snareA]))
  .bank("RolandTR909").gain(.85)

hats: s(arrange([8, hatsA], [8, hatsB], [8, hatsC], [8, hatsA]))
  .bank("RolandTR909")
  .gain("[.9 .45 .7 .45 .8 .45 .55]")
  .late("[0 .025 0 .025 0 .025 0]") // shuffle: offbeat eighths (slots 1,3,5) pushed late ~1/42 cycle (triplet swing); slot 6 stays straight
  .pan(.6)

perc: s(arrange([8, percA], [8, percB], [8, percC], [8, percA]))
  .bank("RolandTR909").gain(.5).pan(.35).room(.3)

crash: s("<cr ~ ~ ~ ~ ~ ~ ~>")
  .bank("RolandTR909").gain(.55).room(.4)

bass: arrange([8, bassA], [8, bassB], [8, silence], [8, bassA])
  .s("sawtooth").lpf(600).release(.06).shape(.3).gain(.9)

chords: arrange([8, chordsA], [8, chordsB], [8, silence], [8, chordsA])
  .scale("D4:dorian").s("piano").gain(.7).room(.35).pan(.4)

pad: arrange([8, silence], [8, silence], [8, padC], [8, silence])
  .scale("D3:dorian").s("sawtooth")
  .attack(.4).release(1)
  .lpf(sine.range(500, 1200).slow(4))
  .gain(.35).room(.6).pan(.5)

lead: arrange([8, leadA], [8, leadB], [8, leadC], [8, leadA])
  .scale("D4:dorian").s("triangle")
  .gain(.8).room(.35)
  .delay(.35).delaytime(.32).delayfeedback(.3)
  .pan(.55)
